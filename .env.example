# .env.example - Cyber Foodie Debate
# 复制为 .env 并填入真实值（严禁提交 .env 到 Git）

# 硅基流动 (SiliconFlow) API
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_MAX_REQUESTS_PER_MINUTE=60
SILICONFLOW_MAX_CONCURRENCY=4

# 其他模型配置
VISION_MODEL=Qwen3.6-35B-A3B

# 微软 TTS 配置
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 数据库（可选，MVP阶段可用JSON文件存储）
# DATABASE_URL=sqlite:///./data/foodie_debate.db
