# .env.example - Cyber Foodie Debate
# 复制为 .env 并填入真实值（严禁提交 .env 到 Git）

# 硅基流动 (SiliconFlow) API
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_MAX_REQUESTS_PER_MINUTE=60
SILICONFLOW_MAX_CONCURRENCY=4

# 其他模型配置
VISION_MODEL=Qwen3.6-35B-A3B

# 微软 TTS 配置
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
# 无需 API Key；默认直连。仅在需要代理时填写实际 HTTP 代理地址。
TTS_PROXY=
TTS_TIMEOUT_SECONDS=30

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# PostgreSQL（本地直接运行后端时使用；Docker Compose 会指向 db 服务）
POSTGRES_DB=cyber_foodie
POSTGRES_USER=cyber_foodie
POSTGRES_PASSWORD=replace_with_a_local_development_password
DATABASE_URL=postgresql+asyncpg://cyber_foodie:replace_with_a_local_development_password@localhost:5432/cyber_foodie

# 第一方 Session 与浏览器安全配置
# HTTPS 部署必须把 SESSION_COOKIE_SECURE 设为 true，并将 FRONTEND_ORIGINS
# 替换为实际前端来源（JSON 数组，不含路径与结尾斜杠）。
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5185","http://127.0.0.1:5185"]
SESSION_COOKIE_NAME=cfd_session
CSRF_COOKIE_NAME=cfd_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=10
DATABASE_READY_TIMEOUT_SECONDS=2
CLOUD_GENERATION_STALE_SECONDS=180
