# Cyber Foodie Debate - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/

# Environment
.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
.dockerignore

# Data
data/*.db
data/*.json
!data/.gitkeep

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Build output
frontend/dist/
frontend/build/

# Secrets
*.pem
*.key
secrets/
